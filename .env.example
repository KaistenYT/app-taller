# ── Entorno de Ejecución ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Base de Datos PostgreSQL ──────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password123
DB_NAME=TALLER_DB

# ── Seguridad y Autenticación ─────────────────────────────────────────────────
# Mínimo 32 caracteres para ACCESS_TOKEN_SECRET
ACCESS_TOKEN_SECRET=esta_es_una_llave_maestra_de_seguridad_de_32_caracteres_minimo

# Secret para Refresh Token (mínimo 32 caracteres)
REFRESH_TOKEN_SECRET=otra_llave_de_seguridad_para_los_refresh_tokens_muy_larga

# ── Frontend y CORS ───────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Configuración de Docker (Opcional) ─────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api
