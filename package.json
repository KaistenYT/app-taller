{
  "name": "TallerGestion-app",
  "productName": "TallerGestion",
  "version": "1.0.0",
  "author": "TallerGestion",
  "description": "Sistema de gestión de taller técnico",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "dev": "npm run rebuild:node && concurrently --kill-others --prefix-colors \"blue,green,yellow\" \"npm run dev --prefix frontend/react/app-taller\" \"npm run server\" \"cross-env NODE_ENV=development electron .\"",
    "server": "nodemon backend/server.js",
    "build:frontend": "npm run build --prefix frontend/react/app-taller",
    "electron:build": "npm run build:frontend && npm run rebuild:electron && electron-builder",
    "electron:dist": "npm run build:frontend && npm run rebuild:electron && electron-builder",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest",
    "lint": "eslint ."
  },
  "build": {
    "appId": "com.gestiontaller.app",
    "productName": "GestionTaller",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/react/app-taller/dist/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/.cache/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/nodemon/**/*",
      "!node_modules/concurrently/**/*",
      "!node_modules/jest/**/*",
      "!node_modules/@jest/**/*",
      "!node_modules/supertest/**/*",
      "!node_modules/cross-env/**/*",
      "!**/frontend/react/app-taller/src/**/*",
      "!**/frontend/react/app-taller/node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "win": {
      "target": [
        "squirrel"
      ],
      "icon": "frontend/react/app-taller/public/icon.png"
    }
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "electron-log": "^5.0.3",
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "node-cache": "^5.1.2",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
