{
  "name": "TallerGestion-app",
  "productName": "TallerGestion",
  "version": "1.0.0",
  "description": "Sistema de gestión de taller técnico",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently --kill-others --prefix-colors \"blue,green,yellow\" \"npm run dev --prefix frontend/react/app-taller\" \"npm run server\" \"cross-env NODE_ENV=development electron .\"",
    "server": "nodemon backend/server.js",
    "build:frontend": "npm run build --prefix frontend/react/app-taller",
    "electron:build": "npm run build:frontend && electron-builder",
    "electron:dist": "npm run build:frontend && electron-builder",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest",
    "lint": "eslint .",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.gestiontaller.app",
    "productName": "GestionTaller",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/react/app-taller/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "frontend/react/app-taller/public/icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "frontend/react/app-taller/public/icon.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "frontend/react/app-taller/public/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^9.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "electron-log": "^5.0.3",
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "node-cache": "^5.1.2",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
